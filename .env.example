API_PORT=3000

# Canvas accounts (add 1, 2, 3... for multiple accounts)
# Bách
CANVAS_URL_1=https://rmit.instructure.com
CANVAS_KEY_1=your_canvas_api_token_1
CANVAS_EMAIL_1=you@example.com                        # optional: notify this email when done/failed


# Canvas folder structure (mặc định Materials2/Q/A — bỏ comment để đổi)
CANVAS_MATERIALS_FOLDER=Materials2
CANVAS_INPUT_FOLDER=Q
CANVAS_OUTPUT_FOLDER=A

# AI Provider Keys
CLAUDE_API_KEY=sk-ant-your-key
GEMINI_API_KEY=your_gemini_api_key
GROK_API_KEY=
OPENAI_API_KEY=your_openai_api_key

# Default models (used when filename does not specify a model)
DEFAULT_MODEL_CLAUDE=claude-sonnet-4-6

# DEFAULT_MODEL_GEMINI=gemini-2.5-flash
DEFAULT_MODEL_GEMINI=gemini-3.5-flash
DEFAULT_MODEL_GROK=grok-3
DEFAULT_MODEL_OPENAI=gpt-6-astra

# Model fallback priority chain (comma-separated, highest priority first)
# When a model fails, the next model in the chain is tried automatically
# NOTE: gemini-2.0-flash shut down 2026-06-01; gemini-2.5-flash restricted for new users
MODEL_FALLBACK_GEMINI=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# MODEL_FALLBACK_CLAUDE=claude-sonnet-4-6,claude-haiku-4-5-20251001
# MODEL_FALLBACK_GROK=grok-3,grok-4-1-fast-reasoning
MODEL_FALLBACK_OPENAI=gpt-6-astra,gpt-5.3-codex,gpt-5,o3-mini,gpt-4o,gpt-4o-mini

# Settings
POLL_INTERVAL_MS=6000
AI_TIMEOUT_MS=120000      # 2 phút per AI call
MAX_RETRY_COUNT=12

# Gmail notifications (optional — leave blank to disable)
# Use a Gmail App Password: myaccount.google.com → Security → App Passwords
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Optional: override Grok base URL if xAI changes endpoint
GROK_BASE_URL=https://api.x.ai/v1

# ─── RAG — Document Vault (optional) ──────────────────────────────
# Để kích hoạt RAG, cần cấu hình Pinecone + Embedding như dưới đây.
# Nếu bỏ trống PINECONE_API_KEY, hệ thống dùng knowledge.md (cũ).
# Xem hướng dẫn chi tiết tại: documents-vault/SETUP-GUIDE.md

PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=canvas-helper
EMBEDDING_PROVIDER=gemini                 # gemini (free, dim=3072) hoặc openai (dim=1536)
VAULT_PATH=./documents-vault                  # Đường dẫn tới thư mục chứa .md
RAG_TOP_K=20                                    # Số chunks lấy từ Pinecone (mặc định 6)
# OPENAI_API_KEY=                           # Chỉ cần nếu EMBEDDING_PROVIDER=openai
EMBEDDING_DELAY_MS=4000                  # Delay giữa batch: gemini ~4000ms, openai ~500ms (auto default nếu bỏ trống)
EMBEDDING_BATCH_SIZE=1                   # Batch size: gemini 1 (tuần tự), openai 100 (batch API)

# --- Neon vault manifest (pg, hierarchies) ---
VAULT_STORAGE_PROVIDER=postgres-r2       # sqlite-disk (dev fallback) | postgres-r2 (Neon prod)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.c-3.aws.neon.tech/db?sslmode=require&channel_binding=require
ADMIN_TOKEN=cter-vault-dev-token         # Bearer cho POST/DELETE /api/vault/files

# --- Handshake: URLs (chỉ cần config 2 env này, deploy đỡ phức tạp) ---
FRONTEND_URL=http://localhost:8443       # monitoring client URL (CORS allow). Prod: https://your-monitoring.vercel.app (có thể comma-separated)
# ALLOWED_ORIGINS=*                      # alternative: comma-separated origins

# --- Cron heartbeat anti-sleep (12m) ---
CRON_ENABLED=true
CRON_INTERVAL_MS=720000                  # 12 * 60 * 1000
