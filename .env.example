# ═══════════════════════════════════════════════════════════════════════
#  PHẦN 1 — THIẾT LẬP CÓ SẴN GIÁ TRỊ (thường không cần sửa)
#  Toàn bộ token / secret / cấu hình bạn PHẢI tự điền nằm ở PHẦN 2 cuối file.
#  Giá trị sai kiểu (vd. POLL_AUTOSTART=yes) làm service dừng ngay khi khởi động.
# ═══════════════════════════════════════════════════════════════════════

API_PORT=3000

# Canvas folder structure (mặc định Materials2/Q/A)
CANVAS_MATERIALS_FOLDER=Materials2
CANVAS_INPUT_FOLDER=Q
CANVAS_OUTPUT_FOLDER=A

# OpenRouter là fallback của backend: luôn gọi direct (key riêng từng provider) trước;
# hết chuỗi direct / lỗi key / provider không có key direct → tự chuyển sang OpenRouter.
# Bật khi OPENROUTER_API_KEY (PHẦN 2) có giá trị. Client không thấy và không chọn được route.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=CTER AI Harness
# OPENROUTER_PROVIDER_SORT=throughput          # price | throughput | latency (bỏ trống = OpenRouter tự chọn)
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_MAX_TOKENS=8192                    # max_tokens mỗi request OpenRouter (credit bị giữ theo số này)

# Default models (dùng khi tên file / chat không ghi model)
DEFAULT_MODEL_CLAUDE=claude-sonnet-4-6
DEFAULT_MODEL_GEMINI=gemini-3.5-flash
DEFAULT_MODEL_GROK=grok-3
DEFAULT_MODEL_OPENAI=gpt-6-astra

# Chuỗi fallback direct (phẩy ngăn cách, ưu tiên cao trước) — thử hết chuỗi này rồi mới tới OpenRouter
# NOTE: gemini-2.0-flash shut down 2026-06-01; gemini-2.5-flash restricted for new users
MODEL_FALLBACK_GEMINI=gemini-3.5-flash,gemini-3.1-flash-lite   # gemini-2.5-flash-lite: 404 cho key mới (08/11)
# MODEL_FALLBACK_CLAUDE=claude-sonnet-4-6,claude-haiku-4-5-20251001
# MODEL_FALLBACK_GROK=grok-3,grok-4-1-fast-reasoning
MODEL_FALLBACK_OPENAI=gpt-6-astra,gpt-5.3-codex,gpt-5,o3-mini,gpt-4o,gpt-4o-mini

# Optional: override Grok base URL if xAI changes endpoint
GROK_BASE_URL=https://api.x.ai/v1

# Polling
# One poll tick (file Q/A + chat) takes several seconds against real Canvas;
# below ~15s ticks run back-to-back. 30s is a good default.
POLL_INTERVAL_MS=30000
# Polling starts on boot (survives restarts/redeploys). Set false to require GET /start.
POLL_AUTOSTART=true

# AI calls
AI_TIMEOUT_MS=120000      # trần mỗi lần gọi KHÔNG stream (polling/Canvas). Stream dùng 2 timeout bên dưới
MAX_RETRY_COUNT=2         # (07) chỉ retry 429/5xx TRƯỚC token đầu. Giá trị cũ 12 làm Gemini treo > 5 phút
AI_FIRST_TOKEN_TIMEOUT_MS=15000   # (07) stream: chờ token đầu tối đa
AI_IDLE_TIMEOUT_MS=20000          # (07) stream: khoảng lặng tối đa giữa 2 chunk
CHAT_DEADLINE_MS=90000            # (07) hạn chót cả chuỗi model (direct + OpenRouter) cho /api/chat
CANVAS_DEADLINE_MS=300000         # hạn chót cả chuỗi cho polling Canvas (file Q&A + hội thoại Canvas; PDF dài)
AI_CIRCUIT_FAILURE_THRESHOLD=3    # (07) 503/overloaded/timeout N lần trong cửa sổ → bỏ qua model
AI_CIRCUIT_WINDOW_MS=60000
AI_CIRCUIT_COOLDOWN_MS=120000
AI_MAX_OUTPUT_TOKENS=16384        # (08) trần output MỌI route: Gemini/OpenAI/Claude/Grok/agent; OpenRouter dùng giá trị này khi không đặt OPENROUTER_MAX_TOKENS
GEMINI_THINKING_LEVEL=minimal     # (07) minimal|low|medium|high; model 2.5 → thinkingBudget 0
OPENAI_REASONING_EFFORT=low       # (07) none|minimal|low|medium|high (chỉ gửi cho o-series/gpt-5*/gpt-6*/codex)
# OPENAI_SERVICE_TIER=priority    # (07) auto|default|flex|priority (trống = không gửi)
OPENAI_PROMPT_CACHE_KEY=conversation  # (18) conversation|prompt_version|off
PROMPT_CACHE_CLAUDE=false         # (18) cache_control cho Claude; chỉ bật khi đo hit rate ≥ 50%
PROMPT_CACHE_LAYOUT=v2            # (18) v2 = system tĩnh, memory ở history/tin cuối; v1 = bố cục cũ (rollback)

# Chat API (09)
MAX_CHAT_IMAGES=10                # số ảnh tối đa mỗi câu hỏi (trước hardcode 4)
CHAT_MAX_BODY_MB=20               # giới hạn body JSON /api/chat
GEMINI_INLINE_IMAGES_MAX_MB=15    # tổng ảnh (đã decode) vượt ngưỡng → Gemini direct upload qua Files API (413 chỉ khi upload lỗi)
CHAT_UPLOAD_TTL_MS=3600000        # ảnh upload qua POST /api/chat/images (tmp/uploads/) phải được dùng trong 1 giờ

# Prompt Registry (06): prompts/ (core + policies + domains + skills). Không có prompts/ = dùng system-prompt.md
# PROMPT_REGISTRY_ENABLED=true    # mặc định bật nếu có prompts/core/system.md; false = system-prompt.md
# PROMPTS_DIR=prompts
# Every instruction lives in prompts/ (12/11): system-prompt.md is GENERATED from it (npm run prompts:legacy) — do not edit it.

# Agent mode (opt-in per request: file "..._openai_agent.txt" or chat header "mode: agent").
# Needs a tool-calling model + PINECONE_API_KEY; otherwise those requests are answered single-shot.
AGENT_MAX_TOOL_CALLS=6
# Tool calls required before the model may answer (0 = model decides; 1 = always search the vault first).
AGENT_MIN_TOOL_CALLS=1
AGENT_MAX_DURATION_MS=180000
# validate_diagram (12/11 plan 03): PlantUML render checks per agent run, outside AGENT_MAX_TOOL_CALLS; 0 = no tool.
AGENT_MAX_DIAGRAM_VALIDATIONS=3

# Diagram syntax guard (12/11 plan 03): after an answer, render each PlantUML block (C4_PLANTUML_SERVER_URL);
# a broken block gets DIAGRAM_SYNTAX_MAX_REPAIRS aux-model repairs (AUX_PROVIDER/AUX_MODEL) and is replaced when it renders.
DIAGRAM_SYNTAX_GUARD_ENABLED=true
DIAGRAM_SYNTAX_MAX_REPAIRS=1
# Connectivity check (12/11 plan 04 §4): rules C1–C9 on /c4 specs (errors → repair, warnings → critic, `connectivity` on
# the `level` event) and an orphan/split/queue lint on PlantUML blocks in chat answers (shares the repair above). 0 tokens.
DIAGRAM_CONNECTIVITY_CHECK=true

# Reranking (cross-encoder over Pinecone candidates). none = cosine order only (default).
# pinecone = Pinecone Inference with the same PINECONE_API_KEY; failures fall back to cosine order.
RERANK_PROVIDER=none
RERANK_MODEL=bge-reranker-v2-m3
RERANK_CANDIDATES=40      # Pinecone top-k fetched before reranking
RERANK_TOP_N=8            # chunks kept for the single-shot prompt
RERANK_TIMEOUT_MS=5000    # measured p95 ≈ 1.6 s, max ≈ 2.7 s (40 candidates)

# RAG — Document Vault (chỉ bật khi PINECONE_API_KEY ở PHẦN 2 có giá trị; trống = dùng knowledge.md)
PINECONE_INDEX=canvas-helper
EMBEDDING_PROVIDER=gemini                 # gemini (free, dim=3072) hoặc openai (dim=1536) — phải khớp index
VAULT_PATH=./documents-vault
RAG_TOP_K=8                               # (07, trước 20) Số chunks lấy từ Pinecone.
RAG_MIN_SCORE=0.3                         # (07) bỏ chunk score < ngưỡng (luôn giữ top 2)
#  (ghi chú cũ) RAG_TOP_K: Khi RERANK_PROVIDER=pinecone: chỉ dùng khi rerank lỗi
HYBRID_SEARCH_ENABLED=true                # (15) BM25 trong RAM (minisearch) + RRF với vector, mọi mode; 0 query Neon. false = chỉ vector

# Essay Mode (15): `/essay [strict] [Nđ]` hoặc mode:"essay" LUÔN chạy; cờ dưới chỉ bật bộ TỰ nhận diện "(N điểm)". Cần Pinecone
ESSAY_MODE_ENABLED=false                  # true = tự chuyển essay khi câu có "(N điểm)" + động từ đề + ≥30 ký tự
ESSAY_MAX_CHUNKS=12                       # số chunk tối đa đưa vào prompt essay (≥2 chunk / khía cạnh)
ESSAY_WORDS_PER_POINT=175                 # target_words = điểm × N
ESSAY_SELF_CHECK=false                    # true = thêm 1 call tự kiểm (luôn chạy khi /essay strict)
ESSAY_THINKING_LEVEL=low                  # minimal|low|medium|high cho call viết essay (Gemini)
ESSAY_MAX_ASPECTS=12                      # (08) số ý/câu tối đa của Essay (trước: cố định 6)
# ESSAY_ANALYSIS_TIMEOUT_MS=6000          # phân tích đề (gộp vào call aux router, timeout = max với ARTIFACT_RESOLVER_AUX_TIMEOUT_MS); quá hạn → heuristic
# ESSAY_SELF_CHECK_TIMEOUT_MS=20000
EMBEDDING_DELAY_MS=4000                   # Delay giữa batch: gemini ~4000ms, openai ~500ms
EMBEDDING_BATCH_SIZE=1                    # Batch size: gemini 1 (tuần tự), openai 100 (batch API)

# Neon vault manifest
VAULT_STORAGE_PROVIDER=postgres-r2        # sqlite-disk (dev fallback) | postgres-r2 (Neon prod, cần DATABASE_URL)
# VAULT_PATH không còn dùng: file vault nằm trên object storage (R2), upload qua POST /api/vault/files

# Object storage: R2 khi đủ 4 biến R2_* ở PHẦN 2; thiếu hết = thư mục local (chỉ dev). Thiếu 1 phần = lỗi khi khởi động.
OBJECT_STORAGE_DIR=./data/object-store     # chỉ dùng khi không có R2

# Hội thoại phía server + context engineering (/api/chat, /api/c4). Mặc định tắt (feature flag).
CONVERSATION_STORE_ENABLED=false           # true = client gửi conversationId, server tự dựng context (cần CHAT_API_TOKEN)
CONVERSATION_PURGE_DAYS=30                 # conversation đã xoá mềm được khôi phục trong N ngày, sau đó purge cả Neon lẫn R2
CONTEXT_KEEP_RECENT_TURNS=6                # số turn giữ nguyên văn khi auto-compact
CONTEXT_COMPACT_THRESHOLD_TOKENS=12000     # vượt ngưỡng (hoặc > 20 turn) thì tóm tắt phần cũ
AUX_PROVIDER=gemini                        # model phụ: caption/OCR ảnh, tóm tắt, viết lại câu hỏi follow-up
AUX_MODEL=gemini-3.1-flash-lite
# AUX_SYNC_TIMEOUT_MS=15000                # chờ OCR tối đa cho câu hỏi chỉ có ảnh
# Artifact Resolver (17): chọn đúng artifact khi user nói "thiết kế bạn làm trước đó"
ARTIFACT_RESOLVER_MODE=rules+aux           # off (hành vi cũ) | rules | rules+aux
ARTIFACT_RESOLVER_MIN_SCORE=2.5
ARTIFACT_RESOLVER_MARGIN=1.0
ARTIFACT_RESOLVER_AUX_TIMEOUT_MS=1500
CONTEXT_PINNED_KINDS=c4_spec,problem_brief,design_review,design_note
# KV cache (18 bước 5): ảnh của N cặp user/assistant gần nhất nằm tại chỗ trong history (≤ 3 ảnh/turn)
CONTEXT_HOT_WINDOW_TURNS=2                 # 0 = hành vi cũ (ảnh cũ chỉ qua JIT) — cờ rollback
CONTEXT_MAX_PROMPT_IMAGES=16               # trần tổng ảnh mỗi prompt (hiện tại + window + JIT); vượt → bỏ ảnh window cũ nhất
# Neon (13 §3.1): cursor poller cache trong RAM, ghi xuống Neon tối đa 1 lần / N ms (+ khi SIGTERM)
POLL_CURSOR_FLUSH_MS=900000

# CORS (monitoring client)
FRONTEND_URL=http://localhost:8443        # Prod: https://your-monitoring.vercel.app (có thể comma-separated)
# ALLOWED_ORIGINS=*                       # alternative: comma-separated origins

# Cron heartbeat anti-sleep (12m)
CRON_ENABLED=true
CRON_INTERVAL_MS=720000                   # 12 * 60 * 1000


# ═══════════════════════════════════════════════════════════════════════
#  PHẦN 2 — BẠN PHẢI CUNG CẤP (token, secret, tài khoản, model OpenRouter)
#  Không commit file .env thật. Bỏ trống = tính năng tương ứng bị tắt.
# ═══════════════════════════════════════════════════════════════════════

# ── Canvas (bắt buộc; thêm _2, _3… cho nhiều tài khoản) ──
CANVAS_URL_1=https://rmit.instructure.com
CANVAS_KEY_1=your_canvas_api_token_1
CANVAS_EMAIL_1=you@example.com            # optional: nhận email khi xong/lỗi

# ── AI keys direct (route chính; chỉ cần provider bạn dùng). Embedding luôn cần OPENAI hoặc GEMINI ──
CLAUDE_API_KEY=
GEMINI_API_KEY=your_gemini_api_key
GROK_API_KEY=
OPENAI_API_KEY=your_openai_api_key

# ── OpenRouter fallback (trống = tắt fallback) ──
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=                       # optional: URL hiện trong thống kê openrouter.ai
# Model OpenRouter dùng khi direct của provider đó thất bại (id vendor/model). Trống = mặc định trong code.
OPENROUTER_MODEL_CLAUDE=anthropic/claude-sonnet-4.5
OPENROUTER_MODEL_GEMINI=google/gemini-2.5-flash
OPENROUTER_MODEL_GROK=x-ai/grok-4.7
OPENROUTER_MODEL_OPENAI=openai/gpt-5
# Fallback phía server mỗi provider (gửi trong field "models"), phẩy ngăn cách
OPENROUTER_FALLBACK_CLAUDE=
OPENROUTER_FALLBACK_GEMINI=
OPENROUTER_FALLBACK_GROK=
OPENROUTER_FALLBACK_OPENAI=

# ── Pinecone (trống = không RAG, không agent, không rerank) ──
PINECONE_API_KEY=

# ── Cloudflare R2 (file vault + ảnh/diagram của hội thoại). Mỗi môi trường 1 bucket: cter-dev / cter-prod ──
# Token: R2 → Manage API tokens → Object Read & Write, "Apply to specific buckets only" = đúng bucket đó.
R2_ACCOUNT_ID=                            # phần đầu của https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=                                # cter-dev (dev) / cter-prod (prod) — điền cùng 3 biến trên, thiếu 1 phần server không khởi động
# R2_ENDPOINT=                            # chỉ khi cần endpoint khác (jurisdiction EU, emulator)

# ── Neon Postgres (bắt buộc khi VAULT_STORAGE_PROVIDER=postgres-r2) ──
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.c-3.aws.neon.tech/db?sslmode=require&channel_binding=require

# ── API tokens (chuỗi ngẫu nhiên, hai token khác nhau) ──
ADMIN_TOKEN=                              # Bearer cho API ghi (vault, /start /stop, cron, xoá log). Trống = mở (không nên)
CHAT_API_TOKEN=                           # Bearer cho /api/chat + /api/retrieve + /api/c4 (client desktop, repo cter-rag-eval). Trống = tắt (503)

# ── Photo capture: API /api/captures cho web app cter-capture-client (Vercel) + người nhận (planning-13112026-photo-capture) ──
# Nhớ thêm origin Vercel của cter-capture-client vào FRONTEND_URL (CORS).
CAPTURE_API_KEY=                          # Key dùng chung với người nhận (header X-Capture-Key). Trống = tắt /api/captures (503). Chuỗi ngẫu nhiên ≥ 32 ký tự
# CAPTURE_UPLOAD_KEY=                     # Tuỳ chọn: key riêng cho upload/xoá (người chụp). Trống = dùng CAPTURE_API_KEY
# CAPTURE_R2_BUCKET=                      # Bucket R2 riêng cho ảnh (vd. cter-capture-dev / cter-capture-prod). Trống = dùng chung R2_BUCKET (prefix captures/); R2 cũng trống = ổ đĩa local
# CAPTURE_R2_ACCESS_KEY_ID=               # Token R2 Object Read & Write chỉ cho CAPTURE_R2_BUCKET. Trống = dùng R2_ACCESS_KEY_ID (token đó phải có quyền trên bucket này)
# CAPTURE_R2_SECRET_ACCESS_KEY=           # Trống = dùng R2_SECRET_ACCESS_KEY
# CAPTURE_R2_ACCOUNT_ID=                  # Trống = dùng R2_ACCOUNT_ID
# CAPTURE_R2_ENDPOINT=                    # Trống = dùng R2_ENDPOINT / endpoint mặc định của account
# CAPTURE_STORAGE_DIR=./data/capture-store   # Chỉ dùng khi không có R2 (dev local)
# CAPTURE_URL_TTL_SECONDS=3600            # Thời hạn URL ảnh presigned trong danh sách (60–604800)
# CAPTURE_MAX_IMAGE_MB=15                 # Giới hạn 1 ảnh upload (1–50); app cter-capture-client tự nén còn ~0.5–1.5 MB

# ── C4 Sketcher (POST /api/c4) — tất cả có mặc định, không đặt gì vẫn chạy ──
C4_PLANTUML_SERVER_URL=https://www.plantuml.com/plantuml   # Server render PNG (cả /api/c4/render xem trước PlantUML trong chat); self-host plantuml/plantuml-server để tránh rate limit
C4_INCLUDE_BASE=https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master   # "stdlib" = dùng bản C4 có sẵn trong PlantUML
C4_DEADLINE_MS=270000                      # Hạn cứng một lần vẽ (60000–290000); hết giờ trả ảnh tốt nhất đã có
C4_CALL_TIMEOUT_MS=150000                  # Trần cho một bước gọi model = min(giá trị này, thời gian còn lại của C4_DEADLINE_MS)
C4_MAX_ELEMENTS=12                         # Số element tối đa mỗi diagram (4–30)
C4_SHOW_LEGEND=false                       # true = thêm SHOW_LEGEND()
C4_DESIGN_DISCUSSION_ENABLED=true          # Bước bàn luận thiết kế T1–T7 sau critic (+1 call/run, cả khi fast); false = rollback. Body `noDiscussion: true` bỏ cho 1 lần

# ── Script eval (06/15) — chỉ cho `npm run eval` / `npm run eval:essay`, server KHÔNG đọc. Chỉ trỏ dev/local, không trỏ prod ──
# HARNESS_URL=http://localhost:3000       # harness đang chạy; cần cùng CHAT_API_TOKEN ở trên. Trống = script bỏ qua
# EVAL_PROVIDER=gemini
# EVAL_MODEL=
# EVAL_JUDGE_PROVIDER=                    # với --judge; nên khác model viết
# EVAL_JUDGE_MODEL=

# ── Gmail notifications (trống = tắt email). Dùng App Password: myaccount.google.com → Security → App Passwords ──
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Trả lời đủ dài, đủ câu (12/11 plan 08) ──
ANSWER_COMPLETENESS_ENABLED=true          # false = tắt orchestrator (rollback: 1 lần gọi như cũ)
ANSWER_MIN_WORDS_PER_QUESTION=300         # câu tự luận không ghi điểm; có điểm = điểm × ESSAY_WORDS_PER_POINT
ANSWER_SECTION_MAX_QUESTIONS=3            # số câu tối đa mỗi phần khi sinh theo phần
ANSWER_MAX_CONTINUATIONS=2                # số lần tự viết tiếp khi bị cắt (mỗi phần / bài essay)
ANSWER_COVERAGE_FIX=true                  # 1 lần gọi bổ sung các câu còn thiếu
LONG_ANSWER_DEADLINE_MS=240000            # hạn chót cả lượt nhiều phần (client timeout 6 phút)
HISTORY_ASSISTANT_TURN_MAX_CHARS=12000    # lượt assistant gần nhất trong lịch sử (các lượt cũ 6000)
