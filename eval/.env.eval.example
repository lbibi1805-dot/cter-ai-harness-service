# Copy to eval/.env.eval (gitignored) and fill in. Variable names are defined
# in eval/rag/domain/eval.enums.ts (EvalEnvKey). The eval is READ-ONLY: it
# only embeds the golden questions and queries the index.

# Production Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=canvas-helper

# Must be the provider the index was built with (openai = 1536 dims, gemini = 3072).
# The script refuses to run if it does not match the index dimension.
EMBEDDING_PROVIDER=openai

# Only the key for EMBEDDING_PROVIDER is required (used to embed the questions).
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Answer eval (npm run eval:answers) ──────────────────────────────
# Neon connection string: used with SELECT statements only (reference docs + agent reads).
DATABASE_URL=
# OpenAI model that answers in BOTH modes; must be a Responses-API model so agent mode can run.
ANSWER_MODEL=gpt-6-astra
# Grader model (JSON mode). Prefer a different model than ANSWER_MODEL.
JUDGE_MODEL=gpt-4o
RAG_TOP_K=20
# Defaults to the repo's system-prompt.md
# SYSTEM_PROMPT_FILE=

# Retrieval/agent settings under test (same names as the service env). Leave
# RERANK_PROVIDER unset (or none) to measure the cosine-only baseline.
RERANK_PROVIDER=pinecone
RERANK_MODEL=bge-reranker-v2-m3
RERANK_CANDIDATES=40
RERANK_TOP_N=8
AGENT_MIN_TOOL_CALLS=1
