# Copy to eval/.env.eval (gitignored) and fill in. Variable names are defined
# in eval/rag/domain/eval.enums.ts (EvalEnvKey). The eval is READ-ONLY: it
# only embeds the golden questions and queries the index.

# Production Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=canvas-helper

# Must be the provider the index was built with (openai = 1536 dims, gemini = 3072).
# The script refuses to run if it does not match the index dimension.
EMBEDDING_PROVIDER=openai

# Only the key for EMBEDDING_PROVIDER is required (used to embed the questions).
OPENAI_API_KEY=
GEMINI_API_KEY=
